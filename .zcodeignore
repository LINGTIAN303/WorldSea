# ── Python cache ────────────────────────────────────────────────────────
**/__pycache__/
*.pyc

# ── pnpm store (local cache) ────────────────────────────────────────────
.pnpm-store/

# ── 旧 node_modules 备份/清理临时目录（清理脚本或手动重命名遗留）────────
# 这些目录不应入库，体积巨大且会触发 EPERM/长路径问题
node_modules_old/
node_modules_old.disabled/
node_modules_trash_*
node_modules_bak_*
# 清理脚本遗留的空目录占位符
*.empty_dir_tmp

# ── Editor temp dirs ────────────────────────────────────────────────────
.qoder-tmp/
# Qoder IDE 配置文件（无代码引用，仅 IDE 自身使用）
.qoderignore
# 清理脚本遗留的空占位目录
_empty_for_clean/

# ── Brainstorming skill runtime state ──────────────────────────────────
# (kept for compatibility if .superpowers is ever re-created)
.superpowers/brainstorm/*/state/
.superpowers/brainstorm/*/*.pid
.superpowers/brainstorm/*/server-*

# ── CatPaw rules (contains sensitive credentials, never commit) ────────
.catpaw/

# ── Midscene 桌面自动化运行产物（截图/报告，仅本地调试用）──────────────
midscene_run/

# ── 本地调试临时产物（截图 / CDP 脚本 / 冒烟验证文件，不入库）────────────
.devtmp/

# ── IDE 运行期配置（.arts 为编辑器本地设置，不应入库）──────────────────
.arts/

# ── 临时/待办文件（本机未归类，不入库）─────────────────────────────────
docs/test.md
write_guide.js

# ── MemoryCenter 项目记忆（本机维护，不入库）────────────────────────────
project_memory.md
apps/tauri/workspace-dist/

