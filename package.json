{
  "name": "worldsmith",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @worldsmith/tauri tauri:dev",
    "dev:tauri": "pnpm --filter @worldsmith/tauri tauri:dev",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "node scripts/clean.js light",
    "clean:deep": "node scripts/clean.js deep",
    "clean:full": "node scripts/clean.js full",
    "install:fallback": "npm install --no-package-lock --legacy-peer-deps --no-audit --no-fund",
    "build:wasm": "wasm-pack build ./tactical-engine --target bundler --out-dir pkg --scope worldsmith --out-name index",
    "build:core": "wasm-pack build ./worldsmith-core --target bundler --out-dir pkg --scope worldsmith --out-name index -- --features wasm",
    "build:wasm-all": "npm run build:wasm && npm run build:core",
    "build": "pnpm --filter @worldsmith/tauri tauri:build",
    "tauri:dev": "pnpm --filter @worldsmith/tauri tauri:dev",
    "tauri:build": "pnpm --filter @worldsmith/tauri tauri:build",
    "build:tauri:standalone": "pnpm --filter @worldsmith/tauri build",
    "build:tauri:app": "pnpm --filter @worldsmith/tauri tauri:build",
    "chat": "cargo run --manifest-path crates/cli/Cargo.toml -- chat",
    "typecheck:tauri": "pnpm --filter @worldsmith/tauri typecheck",
    "typecheck:all": "pnpm --filter @worldsmith/tauri typecheck"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.7",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tiptap/core": "^3.26.1",
    "@tiptap/extension-mention": "^3.26.1",
    "@tiptap/starter-kit": "^3.26.1",
    "@tiptap/suggestion": "^3.26.1",
    "@tiptap/vue-3": "^3.26.1",
    "@windfonts/chinese-fonts": "^1.0.22",
    "@worldsmith/agent-core": "link:./packages/agent-core",
    "@worldsmith/canvas-engine": "link:./packages/canvas-engine",
    "@worldsmith/core": "link:./worldsmith-core/pkg",
    "@worldsmith/entity-core": "link:./packages/entity-core",
    "@worldsmith/font-kit": "link:./packages/font-kit",
    "@worldsmith/governor-core": "link:./packages/governor-core",
    "@worldsmith/memory-archive": "link:./packages/memory-archive",
    "@worldsmith/motion-kit": "link:./packages/motion-kit",
    "@worldsmith/perf-kit": "link:./packages/perf-kit",
    "@worldsmith/plugin-sdk": "link:./packages/plugin-sdk",
    "@worldsmith/shared-composables": "link:./packages/shared-composables",
    "@worldsmith/shared-ui": "link:./packages/shared-ui",
    "@worldsmith/tactical-engine": "link:./tactical-engine/pkg",
    "@worldsmith/theme-kit": "link:./packages/theme-kit",
    "@worldsmith/ui-kit": "link:./packages/ui-kit",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "d3-force": "^3.0.0",
    "dexie": "^4.4.2",
    "docx": "^9.6.1",
    "dompurify": "^3.4.3",
    "echarts": "^6.1.0",
    "gpt-tokenizer": "^2.9.0",
    "graphology": "^0.26.0",
    "graphology-layout": "^0.6.1",
    "graphology-layout-forceatlas2": "^0.10.1",
    "js-yaml": "^4.1.1",
    "jszip": "^3.10.1",
    "lucide-vue-next": "^0.577.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.3",
    "naive-ui": "^2.44.1",
    "pdfjs-dist": "^5.7.284",
    "pinia": "^3.0.4",
    "segmentit": "^2.0.3",
    "sigma": "^3.0.3",
    "turndown": "^7.2.4",
    "vue": "^3.5.32",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@types/d3-force": "^3.0.10",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.12.2",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^3.2.6",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.9.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "storybook": "^8.6.18",
    "typescript": "~6.0.2",
    "vite": "^8.0.10",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^3.2.6",
    "vue-tsc": "^3.2.7"
