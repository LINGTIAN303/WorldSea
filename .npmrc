# npmmirror 可能延迟同步新包（如 vis-data@8.0.4），使用 npm 官方源
registry=https://registry.npmjs.org/
# 使用 hoisted 模式（扁平化 node_modules，避免 importPackage EPERM）
# 之前 isolated 模式在 Windows 上 importPackage 重命名临时目录时反复 EPERM
# hoisted 模式直接摊平到顶级，减少重命名操作
node-linker=hoisted
# pnpm store 放在工作目录内（TRAE Sandbox 不允许访问 D:\.pnpm-store 的 SQLite shm/wal 文件）
store-dir=./.pnpm-store
# 注意：以上 node-linker 和 store-dir 是 pnpm 专用配置，npm 不识别（会产生 warning）
# 如果 pnpm install 反复失败（EPERM/SQLite 错误），改用 npm fallback：
#   npm run install:fallback
# 这会使用 npm install --no-package-lock --legacy-peer-deps 安装依赖
