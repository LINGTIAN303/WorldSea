{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorldSea",
  "identifier": "com.worldsea.desktop",
  "build": {
    "frontendDist": "../shell-loading"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "WorldSea — 世界观构建工具",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "licenseFile": "./installer/LICENSE.txt",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "sidebarImage": "./installer/sidebar.bmp",
        "headerImage": "./installer/header.bmp",
        "installerIcon": "./icons/icon.ico",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
