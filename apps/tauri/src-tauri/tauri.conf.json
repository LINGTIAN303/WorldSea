{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorldSea",
  "version": "0.1.0",
  "identifier": "com.worldsea.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @worldsea/tauri dev",
    "devUrl": "http://localhost:5175",
    "beforeBuildCommand": "pnpm --filter @worldsea/tauri build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "WorldSea — 世界观构建工具",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
