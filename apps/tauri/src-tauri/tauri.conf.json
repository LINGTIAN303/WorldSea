{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorldSmith",
  "version": "0.1.0",
  "identifier": "com.worldsmith.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @worldsmith/tauri dev",
    "devUrl": "http://localhost:5175",
    "beforeBuildCommand": "pnpm --filter @worldsmith/tauri build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "WorldSmith — 世界观构建工具",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
