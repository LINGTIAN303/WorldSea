{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      // @agent/* alias — 共享包内部引用 agent-runtime 的统一别名
      // 通配指向 packages/agent-runtime/src/*，避免引入 worldsmith-agent/src/*（CLI 端代码）
      "@agent/*": ["../../packages/agent-runtime/src/*"],
      "@agent/types": ["../../packages/agent-runtime/src/types.ts"],
      // 共享运行时层
      "@worldsmith/agent-runtime": ["../../packages/agent-runtime/src/index.ts"],
      "@worldsmith/agent-runtime/*": ["../../packages/agent-runtime/src/*"],
      "@worldsmith/agent-core": ["../../packages/agent-core/src/index.ts"],
      "@worldsmith/agent-core/*": ["../../packages/agent-core/src/*"],
      "@worldsmith/governor-core": ["../../packages/governor-core/src/index.ts"],
      "@worldsmith/governor-core/*": ["../../packages/governor-core/src/*"],
      // 共享 composables（Phase 3 迁入）
      "@worldsmith/shared-composables": ["../../packages/shared-composables/src/index.ts"],
      "@worldsmith/shared-composables/*": ["../../packages/shared-composables/src/*"],
      "@worldsmith/shared-composables/agent/*": ["../../packages/shared-composables/src/agent/*"],
      "@worldsmith/shared-composables/long-task/*": ["../../packages/shared-composables/src/agent/long-task/*"],
      // 业务无关的共享 UI/工具包
      "@worldsmith/entity-core": ["../../packages/entity-core/src/index.ts"],
      "@worldsmith/entity-core/*": ["../../packages/entity-core/src/*"],
      "@worldsmith/plugin-sdk": ["../../packages/plugin-sdk/src/index.ts"],
      "@worldsmith/plugin-sdk/*": ["../../packages/plugin-sdk/src/*"],
      "@worldsmith/ui-kit": ["../../packages/ui-kit/src/index.ts"],
      "@worldsmith/canvas-engine": ["../../packages/canvas-engine/src/index.ts"],
      "@worldsmith/canvas-engine/*": ["../../packages/canvas-engine/src/*"],
      "@worldsmith/motion-kit": ["../../packages/motion-kit/src/index.ts"],
      "@worldsmith/font-kit": ["../../packages/font-kit/src/index.ts"],
      "@worldsmith/font-kit/*": ["../../packages/font-kit/src/*"],
      "@worldsmith/perf-kit": ["../../packages/perf-kit/src/index.ts"],
      "@worldsmith/perf-kit/*": ["../../packages/perf-kit/src/*"],
      "@worldsmith/theme-kit": ["../../packages/theme-kit/src/index.ts"],
      "@worldsmith/theme-kit/*": ["../../packages/theme-kit/src/*"],
      "@worldsmith/memory-archive": ["../../packages/memory-archive/src/index.ts"],
      "@worldsmith/memory-archive/*": ["../../packages/memory-archive/src/*"],
      // WASM 包（算法降级用）
      "@worldsmith/core": ["../../worldsmith-core/pkg/index.d.ts"],
      "@worldsmith/tactical-engine": ["../../tactical-engine/pkg/index.d.ts"]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"],
  "exclude": ["node_modules", "dist", "src-tauri"]
}
