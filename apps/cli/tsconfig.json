{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "types": ["node", "vite/client"],
    "noEmit": true,
    "paths": {
      // @agent/* alias — 共享包内部引用 agent-runtime 的统一别名
      "@agent/*": ["../../packages/agent-runtime/src/*"],
      "@agent/types": ["../../packages/agent-runtime/src/types.ts"],
      // 共享运行时层
      "@worldsmith/agent-runtime": ["../../packages/agent-runtime/src/index.ts"],
      "@worldsmith/agent-runtime/*": ["../../packages/agent-runtime/src/*"],
      "@worldsmith/core-api-types": ["../../packages/core-api-types/src/index.ts"],
      "@worldsmith/agent-core": ["../../packages/agent-core/src/index.ts"],
      "@worldsmith/agent-core/*": ["../../packages/agent-core/src/*"],
      "@worldsmith/governor-core": ["../../packages/governor-core/src/index.ts"],
      "@worldsmith/governor-core/*": ["../../packages/governor-core/src/*"],
      // 共享 composables（CLI 端若需复用前端逻辑）
      "@worldsmith/shared-composables": ["../../packages/shared-composables/src/index.ts"],
      "@worldsmith/shared-composables/*": ["../../packages/shared-composables/src/*"],
      // 业务无关的共享 UI/工具包（CLI 端可能用到 entity-core 数据模型、memory-archive 等）
      "@worldsmith/entity-core": ["../../packages/entity-core/src/index.ts"],
      "@worldsmith/entity-core/*": ["../../packages/entity-core/src/*"],
      "@worldsmith/memory-archive": ["../../packages/memory-archive/src/index.ts"],
      "@worldsmith/memory-archive/*": ["../../packages/memory-archive/src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
