{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [],
    "paths": {
      "@worldsmith/agent-runtime": ["../agent-runtime/src/index.ts"],
      "@worldsmith/agent-runtime/*": ["../agent-runtime/src/*"],
      "@worldsmith/core-api-types": ["../core-api-types/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/__tests__/**", "**/*.spec.ts"]
}
