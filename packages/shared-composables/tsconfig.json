{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node"],
    "paths": {
      "@shared": ["./src/index.ts"],
      "@shared/*": ["./src/*"],
      "@agent": ["../agent-runtime/src/index.ts"],
      "@agent/*": ["../agent-runtime/src/*"],
      "@worldsea/agent-core": ["../agent-core/src/index.ts"],
      "@worldsea/agent-core/*": ["../agent-core/src/*"],
      "@worldsea/agent-runtime": ["../agent-runtime/src/index.ts"],
      "@worldsea/agent-runtime/*": ["../agent-runtime/src/*"],
      "@worldsea/core-api-types": ["../core-api-types/src/index.ts"],
      "@worldsea/entity-core": ["../entity-core/src/index.ts"],
      "@worldsea/entity-core/*": ["../entity-core/src/*"],
      "@worldsea/motion-kit": ["../motion-kit/src/index.ts"],
      "@worldsea/motion-kit/*": ["../motion-kit/src/*"],
      "@worldsea/perf-kit": ["../perf-kit/src/index.ts"],
      "@worldsea/perf-kit/*": ["../perf-kit/src/*"],
      "@worldsea/plugin-sdk": ["../plugin-sdk/src/index.ts"],
      "@worldsea/plugin-sdk/*": ["../plugin-sdk/src/*"],
      "@worldsea/ui-kit": ["../ui-kit/src/index.ts"],
      "@worldsea/ui-kit/*": ["../ui-kit/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
