{
  "name": "@worldsmith/agent-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./execution": "./src/execution/index.ts",
    "./execution/adapter": "./src/execution/adapter.ts",
    "./bridge-types": "./src/bridge-types.ts",
    "./toolbus/*": "./src/toolbus/*",
    "./tools/*": "./src/tools/*",
    "./context/*": "./src/context/*",
    "./session/*": "./src/session/*",
    "./group-chat/*": "./src/group-chat/*",
    "./stores/*": "./src/stores/*",
    "./kb/*": "./src/kb/*",
    "./providers/*": "./src/providers/*",
    "./skills/*": "./src/skills/*",
    "./embedding/*": "./src/embedding/*",
    "./mcp/*": "./src/mcp/*",
    "./utils/*": "./src/utils/*",
    "./orchestrator/*": "./src/orchestrator/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "dependencies": {
    "@worldsmith/agent-core": "link:../agent-core",
    "@worldsmith/governor-core": "link:../governor-core",
    "dexie": "^4.4.2"
