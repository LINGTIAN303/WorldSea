{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node"],
    "paths": {
      "@agent": ["./src/index.ts"],
      "@agent/*": ["./src/*"],
      "@worldsmith/agent-runtime": ["./src/index.ts"],
      "@worldsmith/agent-runtime/*": ["./src/*"],
      "@worldsmith/agent-core": ["../agent-core/src/index.ts"],
      "@worldsmith/agent-core/*": ["../agent-core/src/*"],
      "@worldsmith/core-api-types": ["../core-api-types/src/index.ts"],
      "@worldsmith/governor-core": ["../governor-core/src/index.ts"],
      "@worldsmith/governor-core/*": ["../governor-core/src/*"],
      "@worldsmith/entity-core": ["../entity-core/src/index.ts"],
      "@worldsmith/entity-core/*": ["../entity-core/src/*"],
      "@worldsmith/canvas-engine": ["../canvas-engine/src/index.ts"],
      "@worldsmith/canvas-engine/*": ["../canvas-engine/src/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
