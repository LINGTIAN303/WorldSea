{
  "version": 1,
  "_note": "架构策略（ZCode 能力内化 · P 线）。检查器：scripts/architecture/check.mjs；命令：node scripts/architecture/check.mjs [--changed] [--update-baseline] [--self-test]。规则：① 顶层模块目录必须在此登记（新增模块先登记，未登记即报红）；② 新建文件不得超过 maxFileLines，存量超限文件按 architecture-baseline.json 冻结、只禁增长；③ Rust 模块的 path 依赖边必须在 requires 白名单内；④ TS 跨包依赖边必须在 requires 白名单内（镜像 ③）；⑤ TS 包间不得成环。",
  "_status": "v1.1（2026-09-21）：TS 依赖边白名单已启用（40 条现存边登记入库）；阈值 400/1200 经 P4 基线数据复核维持（分布：>400 共 218/1555 ≈14%，存量冻结兜底）；knip 类工具评估后延后独立批次。",
  "global": {
    "maxFileLines": 400,
    "overrides": [
      { "match": "tests", "maxFileLines": 1200 },
      { "match": ".spec.", "maxFileLines": 1200 },
      { "match": ".test.", "maxFileLines": 1200 }
    ],
    "scanExtensions": [".rs", ".ts", ".tsx", ".vue", ".mjs"],
    "excludeDirs": ["node_modules", "target", "dist", "pkg", ".git", "gen", "generated", "mock-cdn"],
    "discoveryRoots": ["crates", "crates/vendor", "packages", "apps", "worldsea-core", "tactical-engine"]
  },
  "modules": [
    { "id": "agent-kernel", "kind": "rust", "roots": ["crates/agent-kernel/src"], "manifest": "crates/agent-kernel/Cargo.toml", "requires": ["agent-engine"] },
    { "id": "agent-engine", "kind": "rust", "roots": ["crates/agent-engine/src"], "manifest": "crates/agent-engine/Cargo.toml", "requires": [] },
    { "id": "agent-patterns", "kind": "rust", "roots": ["crates/agent-patterns/src"], "manifest": "crates/agent-patterns/Cargo.toml", "requires": ["agent-kernel"] },
    { "id": "agent-runtime", "kind": "rust", "roots": ["crates/agent-runtime/src"], "manifest": "crates/agent-runtime/Cargo.toml", "requires": ["agent-kernel", "agent-patterns"] },
    { "id": "agent-memory", "kind": "rust", "roots": ["crates/agent-memory/src"], "manifest": "crates/agent-memory/Cargo.toml", "requires": ["agent-runtime", "vendor-memory-center-core", "vendor-memory-center-llm", "vendor-memory-center-models"] },
    { "id": "agent-index", "kind": "rust", "roots": ["crates/agent-index/src"], "manifest": "crates/agent-index/Cargo.toml", "requires": ["agent-memory", "vendor-memory-center-core"] },
    { "id": "agent-commands", "kind": "rust", "roots": ["crates/agent-commands/src", "crates/agent-commands/tests"], "manifest": "crates/agent-commands/Cargo.toml", "requires": ["agent-engine", "agent-index", "agent-memory", "agent-patterns", "agent-runtime", "vendor-memory-center-core"] },
    { "id": "worldsea-skills-store", "kind": "rust", "roots": ["crates/worldsea-skills-store/src"], "manifest": "crates/worldsea-skills-store/Cargo.toml", "requires": [] },
    { "id": "vendor-memory-center-core-logic", "kind": "rust", "roots": ["crates/vendor/memory-center-core-logic/src"], "manifest": "crates/vendor/memory-center-core-logic/Cargo.toml", "requires": [] },
    { "id": "vendor-memory-center-core", "kind": "rust", "roots": ["crates/vendor/memory-center-core/src"], "manifest": "crates/vendor/memory-center-core/Cargo.toml", "requires": ["vendor-memory-center-core-logic"] },
    { "id": "vendor-memory-center-llm", "kind": "rust", "roots": ["crates/vendor/memory-center-llm/src"], "manifest": "crates/vendor/memory-center-llm/Cargo.toml", "requires": ["vendor-memory-center-core"] },
    { "id": "vendor-memory-center-models", "kind": "rust", "roots": ["crates/vendor/memory-center-models/src"], "manifest": "crates/vendor/memory-center-models/Cargo.toml", "requires": ["vendor-memory-center-core"] },
    { "id": "worldsea-core", "kind": "rust", "roots": ["worldsea-core/src"], "manifest": "worldsea-core/Cargo.toml", "requires": [] },
    { "id": "tactical-engine", "kind": "rust", "roots": ["tactical-engine/src"], "manifest": "tactical-engine/Cargo.toml", "requires": [] },
    { "id": "tauri-backend", "kind": "rust", "roots": ["apps/tauri/src-tauri/src"], "manifest": "apps/tauri/src-tauri/Cargo.toml", "requires": ["agent-commands", "agent-runtime", "worldsea-skills-store", "worldsea-core"] },

