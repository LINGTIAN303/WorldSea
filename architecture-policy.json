    { "id": "shared-ui", "kind": "ts", "roots": ["packages/shared-ui/src"], "manifest": "packages/shared-ui/package.json", "requires": ["agent-runtime-ts", "entity-core", "font-kit", "motion-kit", "perf-kit", "shared-composables", "ui-kit"] },
    { "id": "theme-kit", "kind": "ts", "roots": ["packages/theme-kit/src"], "manifest": "packages/theme-kit/package.json", "requires": [] },
    { "id": "ui-kit", "kind": "ts", "roots": ["packages/ui-kit/src"], "manifest": "packages/ui-kit/package.json", "requires": ["agent-core", "agent-runtime-ts", "canvas-engine", "entity-core", "font-kit", "motion-kit", "perf-kit", "plugin-sdk"] }
  ]
